# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional Telegram Webhook Secret Token for secure validation
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# ACRCloud API Settings for Music Recognition (https://www.acrcloud.com)
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=your_acrcloud_access_key_here
ACRCLOUD_ACCESS_SECRET=your_acrcloud_access_secret_here

# Self-hosted Instagram/YouTube Downloader (Render)
RENDER_DOWNLOADER_URL=https://musify-downloader.onrender.com

# Optional: Upstash Redis or Standard Redis for distributed serverless session/job cache
# If omitted, Musify falls back to stateless token signatures & memory cache
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
