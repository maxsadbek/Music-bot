# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional Telegram Webhook Secret Token for secure validation
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# AudD API Token for Music Recognition (https://audd.io)
AUDD_API_TOKEN=your_audd_api_token_here

# Instagram Downloader / Extraction API Service Settings
# Example API endpoint provider (RapidAPI or custom Instagram media extractor endpoint)
INSTAGRAM_API_URL=https://instagram-downloader-download-instagram-videos-stories1.p.rapidapi.com/get-info
INSTAGRAM_API_KEY=your_rapidapi_or_instagram_api_key_here

# Optional: Upstash Redis or Standard Redis for distributed serverless session/job cache
# If omitted, Musify falls back to stateless token signatures & memory cache
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
